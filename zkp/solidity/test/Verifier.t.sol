pragma solidity ^0.8.25;

import {Test, console} from "forge-std/Test.sol";
import {PlonkVerifier} from "../src/Verifier.sol";

contract VerifierTest is Test {
    PlonkVerifier ZkK1;

    function setUp() public {
        ZkK1 = new PlonkVerifier();
    }

    function test_k1Plonk() public view {
        bytes memory proof =
            hex"";
        uint256[5] memory public_inputs = [
            2504188370884372255185783165435110653583102997062265526101290116072403417624,
            7460449676159416798,
            16993607479718477192,
            2565805421677025963,
            11015090796907421627
        ];

        uint256[] memory inputs = new uint256[](5);
        for (uint256 i = 0; i < 5; i++) {
            inputs[i] = uint256(public_inputs[i]);
        }

        bool res = ZkK1.Verify(proof, inputs);
        assertTrue(res);
        console.log(res);
    }
}
