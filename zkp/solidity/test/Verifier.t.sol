	    }

	    function test_verify() public view {
	bytes memory proof = hex"";
bytes memory public_key_commitment = hex"26ecce5184a1a1135bb87c27bc7359967668313a5d12a36275e045620ae1932d";
bytes memory transaction_hash = hex"98dd76b826575fbb239b926fd1d49aabebd56bf7810a7d886788d7740c28f9de";

	        bool res = ZKV.Verify(proof, public_key_commitment, transaction_hash);
	        assertTrue(res);
	        console.log(res);
	    }
	}
	