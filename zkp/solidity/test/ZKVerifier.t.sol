pragma solidity ^0.8.25;

import {Test, console} from "forge-std/Test.sol";
import {ZKVerifier} from "../src/ZKVerifier.sol";

contract ZKVerifierTest is Test {
    ZKVerifier ZKV;

    function setUp() public {
        ZKV = new ZKVerifier();
    }

    function test_verify() public view {
        bytes memory proof =
            hex"";
        bytes memory public_key_commitment = hex"0589520513e05d28c9c8a1d0fe8fbe3e19ce9d914948bfd227f7966b6f70ba18";
        bytes memory transaction_hash = hex"98dd76b826575fbb239b926fd1d49aabebd56bf7810a7d886788d7740c28f9de";
        console.log("Before ZKV VERIFY");
        bool res = ZKV.Verify(proof, public_key_commitment, transaction_hash);
        console.log("After ZKV VERIFY");
        assertTrue(res);
        console.log(res);
    }
}
